#!/usr/bin/env bash
# wrun — pembungkus peluncuran job (rencana §4). Bash + python stdlib. Tanpa pip.
#   wrun --job <id> [--run-id <rid>] [--phase <p>] [--poweroff-on-success] -- <perintah asli...>
# Menjamin: flock (bukan pgrep), exit code dari PROSES ANAK, RUN_FIN.json bertanda tangan, artefak+sha256.
set -o pipefail
JOB=""; RUN=""; PHASE="run"; POWEROFF=0
while [ $# -gt 0 ]; do case "$1" in
  --job) JOB="$2"; shift 2;; --run-id) RUN="$2"; shift 2;; --phase) PHASE="$2"; shift 2;;
  --poweroff-on-success) POWEROFF=1; shift;; --) shift; break;; *) echo "wrun: argumen tak dikenal $1" >&2; exit 64;; esac; done
[ -n "$JOB" ] || { echo "wrun: --job is required" >&2; exit 64; }
[ $# -gt 0 ] || { echo "wrun: a command is required after --" >&2; exit 64; }
RUN="${RUN:-r$(date -u +%Y%m%dT%H%M%S)}"
DIR="${WARDEN_DIR:-/var/lib/warden}/$JOB"; mkdir -p "$DIR/markers" "$DIR/artifacts"
rm -f "$DIR/markers/RUN_FIN.json"        # RUN_FIN milik run LAMA tidak boleh menyamar sebagai milik run ini (bug 25 Agu: memblokir resume)
LOCK="/run/lock/warden-$JOB.lock"; exec 9>"$LOCK"
flock -n 9 || { echo "wrun: job $JOB is already running (flock $LOCK) — refusing to start a second one" >&2; exit 75; }
export WARDEN_JOB="$JOB" WARDEN_RUN="$RUN" WARDEN_DIR="${WARDEN_DIR:-/var/lib/warden}"
LOG="$DIR/run.log"; START=$(date -u +%s); BOOT=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo "-")
python3 - "$DIR" "$JOB" "$RUN" "$PHASE" "$START" "$BOOT" "$*" <<'PY'
import json, os, sys
d, job, run, phase, start, boot, cmd = sys.argv[1:8]
tmp = os.path.join(d, "markers", "RUN_START.json.tmp")
json.dump({"job_id": job, "run_id": run, "kind": "RUN_START", "phase": phase, "ts": int(start), "boot_id": boot, "cmd": cmd[:500]}, open(tmp, "w"))
os.replace(tmp, os.path.join(d, "markers", "RUN_START.json"))
PY
echo "=== wrun $JOB $RUN phase=$PHASE start=$(date -u -Iseconds) ===" | tee -a "$LOG"
"$@" 2>&1 | tee -a "$LOG"
EXIT=${PIPESTATUS[0]}            # exit code proses anak, bukan tee (mode #11)
END=$(date -u +%s)
# daftar artefak (file di artifacts/ + yang dideklarasikan lewat WARDEN_ARTIFACTS, dipisah spasi) + sha256
python3 - "$DIR" "$JOB" "$RUN" "$PHASE" "$EXIT" "$START" "$END" "$BOOT" <<'PY'
import hashlib, json, os, sys, glob, hmac
d, job, run, phase, ex, start, end, boot = sys.argv[1:9]
paths = sorted(set(glob.glob(os.path.join(d, "artifacts", "**", "*"), recursive=True) + os.environ.get("WARDEN_ARTIFACTS", "").split()))
# file karantina (.corrupt), sementara (.tmp), dan sidecar milik checkpoint yang dikarantina BUKAN artefak (insiden 25 Agu: 3/83 gagal karena .corrupt ikut dideklarasikan)
_karantina = {q[:-len(".corrupt")] for q in paths if q.endswith(".corrupt")}
paths = [q for q in paths if not q.endswith((".corrupt", ".tmp")) and not any(q.startswith(k + ".") for k in _karantina)]
arts = []
for p in paths:
    if os.path.isfile(p):
        h = hashlib.sha256()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
        arts.append({"path": p, "bytes": os.path.getsize(p), "sha256": h.hexdigest()})
        open(p + ".sha256", "w").write(h.hexdigest() + "\n")
ev = {}
evf = os.path.join(d, "evidence.json")            # job boleh menulis {rows:..., metrics:...} sendiri
if os.path.exists(evf):
    try: ev = json.load(open(evf))
    except Exception: ev = {"_error": "evidence.json tidak valid"}
ts = __import__("datetime").datetime.fromtimestamp(int(end), __import__("datetime").timezone.utc).isoformat()
secret = os.environ.get("WARDEN_HMAC", "")
sig = hmac.new(secret.encode(), f"{job}|{run}|{ex}|{ts}".encode(), hashlib.sha256).hexdigest() if secret else ""
fin = {"v": 1, "job_id": job, "run_id": run, "kind": "RUN_FIN", "ts": ts, "exit_code": int(ex), "signal": None,
       "phase": phase, "boot_id": boot, "started": int(start), "ended": int(end), "duration_s": int(end) - int(start),
       "artifacts": arts, "evidence": ev, "signature": sig}
tmp = os.path.join(d, "markers", "RUN_FIN.json.pending")     # becomes RUN_FIN.json only after the log and artifacts have landed in Storage
json.dump(fin, open(tmp, "w"))
print(f"=== wrun finished exit={ex} artifacts={len(arts)} RUN_FIN staged ===")
PY
echo "EXIT=$EXIT" >> "$LOG"
# artefak WAJIB mendarat sebelum job dianggap selesai (mode #21; preempt nyata 25 Agu memakan jendela unggah agent):
# unggah artefak + marker ke GCS secara SINKRON di sini, bukan menunggu agent.
if [ -n "${WARDEN_BUCKET:-}" ] && command -v gcloud >/dev/null 2>&1; then
  gcloud storage cp -r "$DIR/artifacts/"* "gs://$WARDEN_BUCKET/jobs/$JOB/artifacts/" -q 2>/dev/null || echo "wrun: artifact upload FAILED" | tee -a "$LOG"
  # log per run id FIRST: the Diagnostician must find the evidence in Storage the moment the marker appears (catalog #32)
  tail -c 1048576 "$LOG" | gcloud storage cp - "gs://$WARDEN_BUCKET/jobs/$JOB/log/$RUN.log" -q 2>/dev/null || echo "wrun: per-run log upload FAILED" | tee -a "$LOG"
  tail -c 262144 "$LOG" | gcloud storage cp - "gs://$WARDEN_BUCKET/jobs/$JOB/log/tail.log" -q 2>/dev/null || true
  gcloud storage cp "$DIR/markers/RUN_FIN.json.pending" "gs://$WARDEN_BUCKET/jobs/$JOB/markers/RUN_FIN_$RUN.json" -q 2>/dev/null || true
  echo "wrun: log, artifacts and RUN_FIN uploaded to gs://$WARDEN_BUCKET/jobs/$JOB/" | tee -a "$LOG"
fi
mv -f "$DIR/markers/RUN_FIN.json.pending" "$DIR/markers/RUN_FIN.json"   # now the agent may report the run as finished
if [ "$POWEROFF" = 1 ] && [ "$EXIT" = 0 ]; then sleep 90; sudo poweroff; fi   # 90 dtk: beri agent waktu mengirim RUN_FIN
exit "$EXIT"
